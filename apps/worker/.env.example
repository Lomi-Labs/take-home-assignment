# Copy to .env for `pnpm dev`. Every key has a default matching docker compose, except GEMINI_API_KEY.
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Compose postgres and redis, from the host. Inside compose the hosts are `postgres:5432` and `redis:6379`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/lomi-pdf-extractor
REDIS_URL=redis://localhost:6379

# Free key: https://aistudio.google.com/apikey. Never logged; tests never call Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Lease on a claimed version; extended every LEASE_SECONDS / 3 while waiting on Gemini. Must exceed the 60 s LLM timeout.
LEASE_SECONDS=120
# Tries per version before it goes to `failed` for good.
MAX_ATTEMPTS=3
# Versions extracted in parallel by this process.
WORKER_CONCURRENCY=2

# Copy to .env for `pnpm dev`. Every key has a default matching docker compose, so this file is optional.
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Compose postgres, from the host (host port 5433). Inside compose the host is `postgres:5432`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/lomi-pdf-extractor
# Compose redis, from the host. Inside compose the host is `redis:6379`.
REDIS_URL=redis://localhost:6379

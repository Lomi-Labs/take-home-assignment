{
    "name": "doc-review",
    "private": true,
    "packageManager": "pnpm@12.23.0",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "prettier": "3.10.1",
        "turbo": "2.11.13"
    }
}

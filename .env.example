# Read by docker compose only (each app reads its own .env for `pnpm dev`).
# Copy to .env. Every key has a working default except GEMINI_API_KEY.

# --- Postgres container ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lomi-pdf-extractor

# --- Host ports (postgres on 5433 so it doesn't clash with a native postgres on 5432) ---
POSTGRES_PORT=5433
REDIS_PORT=6379
API_PORT=4000
WEB_PORT=3000

# --- LLM, used by the worker. GEMINI_API_KEY is the only key you must set ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Worker tuning, passed to the worker container ---
# How long a claimed version stays `extracting` before the reconciler takes it back. Must exceed the 60 s LLM timeout.
LEASE_SECONDS=120
# Tries per version before it goes to `failed` for good (the Retry button resets this).
MAX_ATTEMPTS=3
# Versions extracted in parallel by one worker process.
WORKER_CONCURRENCY=2
